{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledger-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": {
    "LEDGERSYNC_ENV": "production",
    "MONOBANK_MCP_URL": "https://monobank.srudik.workers.dev/mcp",
    "INTUIT_ACCESS_AUD": "8fab2701b59b19acd7796cb382d75f81822ff88146734e9eed3f60c0a3e0de9a",
    "INTUIT_ACCESS_TEAM_DOMAIN": "https://floral-lake-0d9c.cloudflareaccess.com"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "services": [
    {
      "binding": "MONOBANK_SERVICE",
      "service": "monobank"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledger-sync-db",
      "database_id": "6d295d12-9998-4b26-b70d-a07173edfca0"
    }
  ]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledger-sync-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": {
    "LEDGERSYNC_ENV": "staging",
    "MONOBANK_MCP_URL": "https://monobank.srudik.workers.dev/mcp"
  },
  "services": [{ "binding": "MONOBANK_SERVICE", "service": "monobank" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledger-sync-db-staging",
      "database_id": "0287e219-b02c-4255-8de4-9cfac8155348"
    }
  ],
  "triggers": {
    "crons": []
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ledger-sync-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": {
    "LEDGERSYNC_ENV": "staging",
    "MONOBANK_MCP_URL": "https://monobank.srudik.workers.dev/mcp",
    "INTUIT_ACCESS_AUD": "8fab2701b59b19acd7796cb382d75f81822ff88146734e9eed3f60c0a3e0de9a",
    "INTUIT_ACCESS_TEAM_DOMAIN": "https://floral-lake-0d9c.cloudflareaccess.com"
  },
  "services": [
    {
      "binding": "MONOBANK_SERVICE",
      "service": "monobank"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ledger-sync-db-staging",
      "database_id": "0287e219-b02c-4255-8de4-9cfac8155348"
    }
  ],
  "triggers": {
    "crons": []
  }
}
